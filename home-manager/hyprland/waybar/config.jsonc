// -*- mode: jsonc -*-
// https://github.com/Alexays/Waybar/wiki/Configuration
{
  // "layer": "top", 图层top/bottom
  // "output": "eDP-1", 显示在哪个屏幕上。
  // "position": "top", Bar 的位置可以是 top 、 bottom 、 left 、 right 。
  // "height": 25, 如果可以，请指定条形图的高度；如果要使用动态值，请留空。
  // "width": 1920, 如果可以，请指定条形图的宽度；如果要动态设置宽度，请留空。
  // "modules-left": ["custom/launcher", "hyprland/window" ], 左侧将显示的模块。
  // modules-center
  // modules-right
  // "margin": "12", 使用 CSS 格式设置边距值，不带单位。
  // margin-<top|left|bottom|right>,  使用 CSS 格式设置边距值，不带单位
  // "spacing": 4, 不同模块之间的间隙大小。
  // "name": "bar1", 用来给css对应的名字
  // "mode": "dock", 选择预配置的显示模式之一。这相当于 sway-bar mode 命令，并支持相同的值： dock,hide,invisible,overlay 如果没有 Sway IPC， hide和invisible模式可能不太实用。
  // "start_hidden": false, 可以选择将工具栏设置为隐藏状态。
  // "modifier-reset": "press", 定义使用修饰键重置工具栏可见性的时机。要通过按下修饰键来重置工具栏可见性，请使用 press 。要使用 release 在松开修饰键时重置工具栏可见性，且仅在按下修饰键期间未发生其他操作时才会生效。这可以防止在使用修饰键切换工作区、更改绑定模式或启动快捷键时隐藏工具栏。
  // "exclusive": true, 可选择向合成器请求一个专属区域。禁用此选项可允许在工具栏下方或上方绘制应用程序窗口。默认情况下， overlay 层此功能已禁用。
  // "fixed-center": true,modules-center 块应固定在中心位置。中心块会尽可能保持在条形图的中间。如果其他块需要更多空间，它仍然可以被移动。当值为假时，中间的方块位于左右方块之间的空间中心。
  // "passthrough": false, 可以将任何指针事件传递到工具栏下方的窗口。旨在与 top 或 overlay 层一起使用，且不设专属区域。overlay 层默认启用
  // "ipc": false,可以选择订阅 Sway IPC 栏配置和可见性事件，并使用 swaymsg bar 命令控制路标,需要通过 -b 命令行参数传递 sway 配置中的 bar_id 值，或者通过 id 选项指定。
  // "id": "id-1", bar_id 用于 Sway IPC。如果您需要覆盖通过 -b bar_id 命令行参数传递的特定 bar 实例的值，请使用此参数。
  // "include": [],每个文件可以包含一个对象，该对象可以包含任意一个 bar 配置选项。允许嵌套包含，但请确保避免循环导入。
  // "reload_style_on_change": false.如果检测到样式表文件或任何导入的 CSS 文件发生修改，则启用重新加载 CSS 样式的选项。
  // "on-sigusr1": "toggle", 收到 SIGUSR1 终止信号时执行的操作。可能的值： show 、 hide 、 toggle 、 reload 、 noop
  // "on-sigusr2"
  //
  // on-update
  // on-click, on-click-release
  // on-<double|triple>-click
  // on-click-<middle|right|backward|forward>, on-click-<middle|right|backward|forward>-release
  // on-<double|triple>-click-<middle|right|backward|forward>
  // on-scroll-<up|down|left|right>
  //
  // top bar
  "name": "mainbar",
  "layer": "top",
  "output": "eDP-1",
  "position": "top",
  "height": 25,
  "modules-left": [
    "custom/left_logo",
    "custom/windows_ctrl"
    // "custom/left_1",
    // "hyprland/workspaces",
    // "custom/left_2"
  ],
  "modules-center": [
    // center left
    "custom/center_left_3",
    "custom/singbox",
    "custom/netbird",
    "custom/center_left_2",
    "custom/cpuinfo", // temperature
    "custom/center_left_1",
    "custom/cpu", // cpu
    "memory", // memory
    // logo
    "custom/logo_left",
    "custom/logo_left_in",
    "custom/logo",
    "custom/logo_right_in",
    "custom/logo_right",
    // center right
    "clock#time", // time
    "custom/center_right_3",
    "clock#date", // date
    "custom/center_right_2",
    "custom/wifi",
    "bluetooth",
    "custom/center_right_1"
  ],
  "modules-right": [
    "tray",
    "custom/right_4",
    "custom/mic",
    "custom/right_3",
    "pulseaudio", // output device
    "custom/right_2",
    "backlight", // brightness
    "custom/right_1",
    // battery
    "battery",
    "custom/right_in_1",
    // power button
    "custom/power_control"
  ],
  "mode": "dock",
  "custom/os_button": {
    "format": "",
    "on-click": "tofi-drun",
    "tooltip": false
  },
  "custom/workspacesduck": {},
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 10,
    "spacing": 0,
    "tooltip-format": "{title}",
    "ignore-list": [],
    "on-click": "activate"
  },
  "custom/left_logo": {
    "format": "EVANGELION 󱤓 󰫍󰫍󰫍 ",
    "tooltip": false
  },
  // 这个应该加功能，点击后平铺所有窗口
  "custom/windows_ctrl": {
    "format": " ",
    "tooltip": false,
    "min-length": 3,
    "max-length": 3
  },
  "custom/left_1": {
    "format": "",
    "tooltip": false
  },
  // "hyprland/workspaces": {
  //   "on-scroll-up": "hyprctl dispatch workspace -1",
  //   "on-scroll-down": "hyprctl dispatch workspace +1",
  //   "persistent-workspaces": {
  //     "1": [],
  //     "2": [],
  //     "3": [],
  //     "4": [],
  //     "5": [],
  //     "6": [],
  //     "7": [],
  //     "8": [],
  //     "9": []
  //   },
  //   "min-length": 9,
  //   "max-length": 9
  // },
  "custom/left_2": {
    "format": "",
    "tooltip": false
  },
  // 显示器应该用hyprctl monitor有个控制
  // 应该有个电源控制,点击后是是重启、关机、登出、锁定、休眠、睡眠
  // 蓝牙、剪贴板、wifi用托盘
  "custom/center_left_3": {
    "format": "",
    "tooltip": false
  },
  // sing-box 的，应该是鼠标提示是当前节点和出口ip
  // css中颜色应该是singbox服务的状态
  // 应该获取clash api，右键获取所有节点，并可以选择节点
  // 左键应该弹出菜单，有关闭，重启，和打开
  "custom/singbox": {
    "format": " 󰆧 ",
    "min-length": 4,
    "max-length": 4,
    "tooltip": false,
    "menu": "on-click-right",
    "menu-file": "~/.config/waybar/menus/singbox_menu.xml",
    "menu-actions": {
      "start": "systemctl start singbox &>/dev/null",
      "stop": "systemctl stop singbox &>/dev/null",
      "restart": "systemctl restart singbox &>/dev/null",
      "update": "systemctl stop singbox && systemctl restart singbox-update-config && systemctl start singbox &>/dev/null"
    }
  },
  // netbird自定义，鼠标提示当前netbird状态netbird status 中的Relays: 1/4 Available和Signal等关键状态
  // 并且状态异常应该在css中变色
  // 左键应该弹出菜单，关闭，重启，和打开
  "custom/netbird": {
    "format": " 󱗆 ",
    "min-length": 4,
    "max-length": 4,
    "tooltip": false,
    "menu": "on-click-right",
    "menu-file": "~/.config/waybar/menus/netbird_menu.xml",
    "menu-actions": {
      "start": "netbird up",
      "stop": "netbird down",
      "restart": "netbird down && netbird up",
      "login": "netbird login"
    }
  },
  "custom/center_left_2": {
    "format": "",
    "tooltip": false
  },
  "custom/cpuinfo": {
    "exec": "~/.config/waybar/scripts/cpu-temp.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 5,
    "min-length": 8,
    "max-length": 8
  },
  "custom/center_left_1": {
    "format": "",
    "tooltip": false
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu-usage.sh",
    "return-type": "json",
    "tooltip": true,
    "interval": 5,
    "min-length": 4,
    "max-length": 4
  },
  "memory": {
    "states": {
      "warning": 75,
      "critical": 90
    },
    "format": "|{percentage}%",
    "format-critical": "󰀦 {percentage}%",
    "tooltip": true,
    "tooltip-format": "Memory Used: {used:0.1f} GB / {total:0.1f} GB",
    "interval": 5,
    "min-length": 4,
    "max-length": 4
  },
  // center logo
  "custom/logo_left": {
    "format": "",
    "tooltip": false
  },
  "custom/logo_left_in": {
    "format": "",
    "tooltip": false
  },
  "custom/logo": {
    "format": "EVA",
    "tooltip": false
  },
  "custom/logo_right_in": {
    "format": "",
    "tooltip": false
  },
  "custom/logo_right": {
    "format": "",
    "tooltip": false
  },
  // time
  "clock#time": {
    "format": "󱑂 {:%H:%M}",
    "tooltip": true,
    "tooltip-format": "Standard Time: {:%I:%M %p}",
    "min-length": 8,
    "max-length": 8
  },
  "custom/center_right_3": {
    "format": "",
    "tooltip": false
  },
  // data
  "clock#date": {
    "format": "󰨳 {:%m-%d}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 6,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#b4befe'><b>{}</b></span>",
        "weekdays": "<span color='#a6adc8' font='7'>{}</span>",
        "today": "<span color='#f38ba8'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click": "mode",
      "on-click-right": "mode"
    },
    "min-length": 8,
    "max-length": 8
  },
  "custom/center_right_2": {
    "format": "",
    "tooltip": false
  },
  //
  "custom/wifi": {
    "exec": "~/.config/waybar/scripts/wifi-status.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
    "on-click-right": "ghostty -e nmtui",
    "interval": 1,
    "min-length": 4,
    "max-length": 4
  },
  "bluetooth": {
    "format": "󰂰",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "tooltip-format": "{num_connections} connected",
    "tooltip-format-disabled": "Bluetooth Disabled",
    "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}: {device_battery_percentage}%",
    "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
    "on-click-right": "ghostty -e bluetui",
    "interval": 1,
    "min-length": 4,
    "max-length": 4
  },
  "custom/center_right_1": {
    "format": "",
    "tooltip": false
  },
  // ============= right ==============
  // tray
  "tray": {
    "icon-size": 12,
    "spacing": 4
  },
  // mic
  "custom/right_4": {
    "format": "",
    "tooltip": false
  },
  "custom/mic": {
    "format": "󰍬 100% ",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },
  // pulseaudio
  "custom/right_3": {
    "format": "",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "headphone": "󰋋",
      "headset": "󰋋"
    },
    "tooltip": true,
    "tooltip-format": "输出设备: {desc}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
    "min-length": 8,
    "max-length": 8
  },
  // backlight
  "custom/right_2": {
    "format": "",
    "tooltip": false
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "device": "intel_backlight",
    "on-scroll-up": "brightnessctl -d intel_backlight set 1%+ >/dev/null && brightnessctl -d asus_screenpad set $(($(brightnessctl -m -d intel_backlight | awk -F, '{print substr($4, 0, length($4)-1)}')/2))% >/dev/null",
    "on-scroll-down": "brightnessctl -d intel_backlight set 1%- >/dev/null && brightnessctl -d asus_screenpad set $(($(brightnessctl -m -d intel_backlight | awk -F, '{print substr($4, 0, length($4)-1)}')/2))% >/dev/null",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "min-length": 8,
    "max-length": 8
  },
  // battery
  "custom/right_1": {
    "format": "",
    "tooltip": false
  },
  "battery": {
    "states": {
      "full": 100,
      "good": 99,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}% ",
    "format-icons": [
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂"
    ],
    "format-full": "󱃌 {capacity}% ",
    "format-warning": "󰁻 {capacity}% ",
    "format-critical": "󱃍 {capacity}% ",
    "format-charging": "󱘖 {capacity}% ",
    "tooltip-format": "Discharging: {time}",
    "tooltip-format-charging": "Charging: {time}",
    "interval": 5,
    "min-length": 8,
    "max-length": 8
  },
  "custom/right_in_1": {
    "format": "",
    "tooltip": false
  },
  // power button
  "custom/power_control": {
    "format": "⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/menus/power_menu.xml",
    "menu-actions": {
      "lock": "hyprlock",
      "logout": "hyprctl dispatch exit",
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  }
}